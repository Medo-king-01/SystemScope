# SystemScope — Git Ignore

# Build artifacts
build/
dist/
*.spec
*.egg-info/
__pycache__/
src/__pycache__/
src/*/__pycache__/
*.pyc
*.pyo
*.pyd

# Database
*.db
*.sqlite
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Windows
*.log
nul

# Virtual environment
venv/
.env
.env.local
.venv/

# Test files
test_*.py
*_test.py
tests/

# Dependencies
# (installed via pip, not tracked)
# requirements.txt IS tracked

# PyInstaller
!dist/  # Keep dist folder for built executables
!assets/